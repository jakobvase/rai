#!/bin/bash
# rai push - Push current git repo to RAI VM

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"

force=false
if [ "$1" = "--force" ]; then
  force=true
  shift
fi

ip=$(provider_ip)

if [ -z "$ip" ] || [ "$ip" = "null" ]; then
  echo "Could not get VM IP. Is the server running?"
  exit 1
fi

repo_name=$(basename "$RAI_REPO_ROOT")
remote_path="$RAI_REMOTE_BASE/$repo_name"
remote_url="ssh://$RAI_USER@$ip$remote_path"

# Set up repo on VM if needed
ssh "$RAI_USER@$ip" "
  if [ ! -d '$remote_path/.git' ]; then
    mkdir -p '$remote_path'
    git init '$remote_path'
    git -C '$remote_path' config receive.denyCurrentBranch updateInstead
  fi
"

branch=$(git symbolic-ref --short -q HEAD)
if [ -z "$branch" ]; then
  echo "Not on a branch (detached HEAD). Checkout a branch before pushing."
  exit 1
fi
lease_ref="refs/rai-remote/$branch"

if [ "$force" = true ]; then
  git push --force "$remote_url" "$branch" || exit 1
else
  expected_sha=$(git rev-parse --verify -q "$lease_ref" 2>/dev/null)
  git push --force-with-lease="$branch:$expected_sha" "$remote_url" "$branch" || exit 1
fi
git update-ref "$lease_ref" "$branch"

ssh "$RAI_USER@$ip" "git -C '$remote_path' checkout '$branch'"
