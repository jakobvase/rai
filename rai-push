#!/bin/bash
# rai push - Push current git repo to RAI VM
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"
source "$SCRIPT_DIR/rai-common"

force=false
if [ "${1:-}" = "--force" ]; then
  force=true
  shift
fi

# `git push` only ever sends committed history, so uncommitted changes
# (staged or unstaged) silently stay behind - the user may assume the VM
# now matches what's on screen when it doesn't. Untracked files are left
# out of this check: they're never part of what a push would carry either
# way, and are a much weaker signal that the user meant to bring them along.
# This has to run before any remote work - no reason to touch the VM just
# to bail out on a local confirmation. `|| true` guards the assignment
# under `set -e`: grep exits 1 on a clean tree (no matching lines), which
# isn't a real failure here.
uncommitted="$(git status --porcelain | grep -v '^??' || true)"
if [ -n "$uncommitted" ]; then
  echo "Warning: you have uncommitted changes that will NOT be pushed (only committed history is sent):" >&2
  echo "$uncommitted" >&2
  if [ -t 0 ]; then
    read -r -p "Continue pushing anyway? [y/N] " reply
    case "$reply" in
      [yY]*) ;;
      *)
        echo "Aborted." >&2
        exit 1
        ;;
    esac
  else
    # No tty to prompt (script/CI/test invocation) - never block waiting
    # for input that will never come. Proceed, but make sure the warning
    # above still made it to the user rather than being silently skipped.
    echo "Non-interactive session (no tty) - proceeding without confirmation." >&2
  fi
fi

ip=$(require_ip) || exit 1
remote_path=$(remote_repo_path) || exit 1
remote_url="ssh://$RAI_USER@$ip$remote_path"
q_remote_path=$(shell_quote "$remote_path")

# Set up repo on VM if needed (mkdir/init are genuinely one-time - gated
# behind .git existing). Remote config that must hold goes below the `if`,
# unconditional, so it's re-asserted every push and retroactively applies
# to repos that were already `git init`'d before the setting existed - not
# just newly created ones.
# shellcheck disable=SC2029  # intentional: q_remote_path is already
# shell_quote()'d, so it's meant to expand client-side into the command
# string sent to the remote shell, not to be re-quoted for local expansion.
ssh "$RAI_USER@$ip" "
  if [ ! -d $q_remote_path/.git ]; then
    mkdir -p $q_remote_path
    git init $q_remote_path
  fi
  git -C $q_remote_path config receive.denyCurrentBranch updateInstead
"

branch=$(git symbolic-ref --short -q HEAD) || true
if [ -z "$branch" ]; then
  echo "Not on a branch (detached HEAD). Checkout a branch before pushing." >&2
  exit 1
fi

# We keep track of where the remote is. One of the goals of this project is to not
# have two remotes in git, because that's annoying to work with. But that means we
# have to track the remote ourselves in refs.
lease_ref="refs/rai-remote/$branch"

if [ "$force" = true ]; then
  git push --force "$remote_url" "$branch" || exit 1
else
  expected_sha=$(git rev-parse --verify -q "$lease_ref" 2>/dev/null) || true
  git push --force-with-lease="$branch:$expected_sha" "$remote_url" "$branch" || exit 1
fi

q_branch=$(shell_quote "$branch")
# -q: the remote is already on this branch on every push but the first, and
# a plain checkout prints "Already on '<branch>'" to stderr in that case -
# harmless but noisy on every single push. -q only silences that feedback
# message; real errors (bad ref, conflicting local changes) and the exit
# code still come through untouched.
# shellcheck disable=SC2029  # intentional: q_remote_path/q_branch are
# already shell_quote()'d, so they're meant to expand client-side (see above).
if ! ssh "$RAI_USER@$ip" "git -C $q_remote_path checkout -q $q_branch"; then
  echo "Remote checkout of '$branch' failed after push; remote may be out of sync. Not recording lease." >&2
  exit 1
fi

# Only now that the remote's HEAD/working tree are confirmed to actually be
# on $branch do we record the lease - it must attest that the remote is
# truly in sync, not merely that our push was accepted.
git update-ref "$lease_ref" "$branch"
