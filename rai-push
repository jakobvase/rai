#!/bin/bash
# rai push - Push current git repo to RAI VM
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"
source "$SCRIPT_DIR/rai-common"

force=false
if [ "${1:-}" = "--force" ]; then
  force=true
  shift
fi

ip=$(require_ip) || exit 1
remote_path=$(remote_repo_path) || exit 1
remote_url="ssh://$RAI_USER@$ip$remote_path"
q_remote_path=$(shell_quote "$remote_path")

# Set up repo on VM if needed (mkdir/init are genuinely one-time - gated
# behind .git existing). Remote config that must hold goes below the `if`,
# unconditional, so it's re-asserted every push and retroactively applies
# to repos that were already `git init`'d before the setting existed - not
# just newly created ones.
ssh "$RAI_USER@$ip" "
  if [ ! -d $q_remote_path/.git ]; then
    mkdir -p $q_remote_path
    git init $q_remote_path
  fi
  git -C $q_remote_path config receive.denyCurrentBranch updateInstead
"

branch=$(git symbolic-ref --short -q HEAD) || true
if [ -z "$branch" ]; then
  echo "Not on a branch (detached HEAD). Checkout a branch before pushing." >&2
  exit 1
fi
lease_ref="refs/rai-remote/$branch"

if [ "$force" = true ]; then
  git push --force "$remote_url" "$branch" || exit 1
else
  expected_sha=$(git rev-parse --verify -q "$lease_ref" 2>/dev/null) || true
  git push --force-with-lease="$branch:$expected_sha" "$remote_url" "$branch" || exit 1
fi

q_branch=$(shell_quote "$branch")
if ! ssh "$RAI_USER@$ip" "git -C $q_remote_path checkout $q_branch"; then
  echo "Remote checkout of '$branch' failed after push; remote may be out of sync. Not recording lease." >&2
  exit 1
fi

# Only now that the remote's HEAD/working tree are confirmed to actually be
# on $branch do we record the lease - it must attest that the remote is
# truly in sync, not merely that our push was accepted.
git update-ref "$lease_ref" "$branch"
