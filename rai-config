# rai-config - Shared configuration loader for rai-* scripts.
# Sourced (not executed) by each rai-* script; do not run this directly.
#
# Precedence, highest to lowest:
#   1. Already-exported environment variables
#   2. <repo-root>/.rai/rai.conf (repo defaults, committed, shared with the team)
#   3. ~/.rai/rai.conf          (per-machine override, not committed)
#   4. Hardcoded fallback defaults below
#
# Both config files are plain `KEY=value` text files, one assignment per
# line, and are parsed (not sourced/eval'd) by _rai_load_config_file below.
# Only lines assigning one of the known $_rai_config_vars are applied; a
# value may optionally be wrapped in matching single or double quotes,
# which are stripped, but is otherwise taken as literal text - there is no
# `$(...)`, backtick, or variable-expansion support, so a config file
# cannot run arbitrary shell no matter what it contains. This matters most
# for <repo-root>/.rai/rai.conf, since that one is meant to be committed and
# shared with the team (and so can arrive via a clone or a PR, not just a
# file you personally wrote).

RAI_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || true

# Config files assign unconditionally, so remember which of these vars the
# caller already exported and restore them afterwards - env vars must win
# over both config files. Deliberately avoids `declare -A` (bash 4+) so this
# works on older bash too (e.g. macOS's stock /bin/bash, which is 3.2);
# instead each var gets its own scalar capture (`_rai_preset_$name`) plus a
# separate "was it set at all" flag (`_rai_preset_set_$name`), since a
# preset-but-empty value must still be restored as empty rather than treated
# as unset.
_rai_config_vars="RAI_SERVER RAI_USER RAI_REMOTE_BASE RAI_VOLUME RAI_PROVIDER RAI_STATIC_IP"
for _rai_var in $_rai_config_vars; do
  if [ -n "${!_rai_var+x}" ]; then
    eval "_rai_preset_set_${_rai_var}=1"
    eval "_rai_preset_${_rai_var}=\${${_rai_var}}"
  fi
done

# _rai_load_config_file <path> - strict, non-executing `KEY=value` parser.
# Reads $1 line by line and applies only lines of the form KEY=value where
# KEY is one of $_rai_config_vars; everything else (blank lines, `#`
# comments, unrecognized keys, malformed lines) is skipped, with a warning
# on stderr for anything that isn't blank/a comment. A value may be wrapped
# in one matching pair of double or single quotes, which is stripped; the
# result is assigned verbatim via `printf -v`, with no further shell
# evaluation, so `$(...)`, backticks, and variable expansion in a value are
# inert literal text, not executed. Always returns 0, so a bad line in a
# config file can never abort a caller running under `set -e`.
_rai_load_config_file() {
  local file="$1" line line_no=0 key value allowed is_allowed
  while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))

    # Trim leading/trailing whitespace.
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    [ -z "$line" ] && continue
    case "$line" in
      \#*) continue ;;
    esac

    case "$line" in
      *=*)
        key="${line%%=*}"
        value="${line#*=}"
        ;;
      *)
        echo "rai-config: warning: ignoring malformed line $line_no in $file" >&2
        continue
        ;;
    esac

    is_allowed=""
    for allowed in $_rai_config_vars; do
      [ "$key" = "$allowed" ] && { is_allowed=1; break; }
    done
    if [ -z "$is_allowed" ]; then
      echo "rai-config: warning: ignoring unrecognized key '$key' in $file" >&2
      continue
    fi

    # Strip one matching pair of surrounding quotes, if present. No other
    # shell syntax in the value (quoted or not) is interpreted.
    case "$value" in
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac

    # A value starting with `-` is never legitimate for any of these vars,
    # and could otherwise be parsed as a CLI option by a downstream command
    # (ssh, scp, hcloud, or the `source` used to pick a provider file).
    case "$value" in
      -*)
        echo "rai-config: warning: ignoring value starting with '-' for key '$key' on line $line_no in $file" >&2
        continue
        ;;
    esac

    printf -v "$key" '%s' "$value"
  done < "$file"
  return 0
}

[ -f "$HOME/.rai/rai.conf" ] && _rai_load_config_file "$HOME/.rai/rai.conf"
[ -n "$RAI_REPO_ROOT" ] && [ -f "$RAI_REPO_ROOT/.rai/rai.conf" ] && _rai_load_config_file "$RAI_REPO_ROOT/.rai/rai.conf"
unset -f _rai_load_config_file

for _rai_var in $_rai_config_vars; do
  eval "_rai_was_preset=\${_rai_preset_set_${_rai_var}:-}"
  if [ -n "$_rai_was_preset" ]; then
    eval "printf -v $_rai_var '%s' \"\$_rai_preset_${_rai_var}\""
  fi
  eval "unset _rai_preset_${_rai_var} _rai_preset_set_${_rai_var}"
done
unset _rai_var _rai_config_vars _rai_was_preset

RAI_USER="${RAI_USER:-user}"
RAI_SERVER="${RAI_SERVER:-rai}"
RAI_REMOTE_BASE="${RAI_REMOTE_BASE:-/home/$RAI_USER/workspaces}"
RAI_VOLUME="${RAI_VOLUME:-/dev/sdb}"
RAI_PROVIDER="${RAI_PROVIDER:-hetzner}"

case "$RAI_PROVIDER" in
  hetzner|selfhosted) ;;
  *)
    echo "rai-config: error: unknown RAI_PROVIDER '$RAI_PROVIDER' (expected 'hetzner' or 'selfhosted')" >&2
    exit 1
    ;;
esac
