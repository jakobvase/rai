#!/bin/bash
# rai pull - Pull changes from VM back to local repo
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck source=lib/rai-config
source "$SCRIPT_DIR/rai-config"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"
# shellcheck source=lib/rai-common
source "$SCRIPT_DIR/rai-common"

ip=$(require_ip) || exit 1
remote_path=$(remote_repo_path) || exit 1
remote_url="ssh://$RAI_USER@$ip$remote_path"

branch=$(git rev-parse --abbrev-ref HEAD)
git fetch "$remote_url" "$branch" \
  && git update-ref "refs/rai-remote/$branch" FETCH_HEAD \
  && git merge FETCH_HEAD
