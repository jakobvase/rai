#!/bin/bash
# rai unlock - Unlock the encrypted workspace volume
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck source=lib/rai-config
source "$SCRIPT_DIR/rai-config"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"
# shellcheck source=lib/rai-common
source "$SCRIPT_DIR/rai-common"

ip=$(require_ip) || exit 1
q_remote_base=$(shell_quote "$RAI_REMOTE_BASE")
q_volume=$(shell_quote "$RAI_VOLUME")

ssh -t "$RAI_USER@$ip" "
  if mountpoint -q $q_remote_base; then
    echo 'Already unlocked and mounted.'
    exit 0
  fi
  if [ ! -e /dev/mapper/data ]; then
    sudo cryptsetup luksOpen $q_volume data || exit 1
  fi
  sudo mount /dev/mapper/data $q_remote_base
  echo Unlocked and mounted $q_remote_base.
"
