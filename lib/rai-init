#!/bin/bash
# rai init - Interactively scaffold <repo-root>/.rai/rai.conf
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"
source "$SCRIPT_DIR/rai-common"

if [ -z "$RAI_REPO_ROOT" ]; then
  echo "Error: not inside a git repository." >&2
  exit 1
fi

# Unlike every other config var, rai-config gives RAI_STATIC_IP no hardcoded
# fallback (there isn't a sensible one) - so if it was never exported nor set
# in either config file, it's left truly unset, not just empty, which would
# trip `set -u` the first time this script reads it below.
RAI_STATIC_IP="${RAI_STATIC_IP:-}"

yes=false
case "${1:-}" in
  -y|--yes) yes=true ;;
esac

conf_dir="$RAI_REPO_ROOT/.rai"
conf_file="$conf_dir/rai.conf"

# The mode switch here is the -y/--yes flag, not an isatty check like
# rai-push's confirmation uses: rai-push has no flag of its own to fall back
# on, so it has to guess from the tty whether a human is available to answer.
# rai-init always has an explicit flag, so it can just trust it - which also
# means `read` below works the same whether stdin is a real terminal or
# piped input (e.g. in tests), since there's no tty check gating it.
if [ -f "$conf_file" ]; then
  if [ "$yes" = true ]; then
    echo "Error: $conf_file already exists. Refusing to overwrite with --yes; re-run 'rai init' without it to confirm interactively." >&2
    exit 1
  fi
  echo "Warning: $conf_file already exists." >&2
  read -r -p "Overwrite it? [y/N] " reply
  case "$reply" in
    [yY]*) ;;
    *)
      echo "Aborted." >&2
      exit 1
      ;;
  esac
fi

if [ "$yes" = true ]; then
  provider="$RAI_PROVIDER"
else
  echo "Which provider?"
  echo "  1) hetzner"
  echo "  2) selfhosted"
  default_choice=1
  [ "$RAI_PROVIDER" = "selfhosted" ] && default_choice=2
  read -r -p "Choice [$default_choice]: " choice
  choice="${choice:-$default_choice}"
  case "$choice" in
    1) provider=hetzner ;;
    2) provider=selfhosted ;;
    *)
      echo "Error: invalid choice '$choice' (expected 1 or 2)." >&2
      exit 1
      ;;
  esac
fi

# RAI_SERVER only matters to the hetzner provider (it's the server name
# `hcloud` looks up) - selfhosted ignores it entirely in favor of
# RAI_STATIC_IP below, so asking for it there would just be confusing.
server="$RAI_SERVER"
if [ "$provider" = hetzner ] && [ "$yes" != true ]; then
  read -r -p "Server name [$RAI_SERVER]: " input
  server="${input:-$RAI_SERVER}"
fi

static_ip=""
if [ "$provider" = selfhosted ]; then
  if [ "$yes" = true ]; then
    if [ -z "$RAI_STATIC_IP" ]; then
      echo "Error: RAI_PROVIDER=selfhosted requires RAI_STATIC_IP, but none is set (no hardcoded fallback exists for it)." >&2
      echo "Set RAI_STATIC_IP (as an env var, or in ~/.rai/rai.conf) before running with --yes, or run 'rai init' without --yes to be prompted." >&2
      exit 1
    fi
    static_ip="$RAI_STATIC_IP"
  else
    # Re-prompt on empty input - this var is the entire reason 'rai init'
    # earns its keep for this provider, so it must not end up blank in the
    # file. But bail on EOF (a closed/exhausted stdin) rather than spinning
    # forever: `read` returns immediately at EOF, so looping on that would
    # be a tight busy-loop, not a harmless wait for a human to type.
    while true; do
      if [ -n "$RAI_STATIC_IP" ]; then
        prompt="Static IP or hostname [$RAI_STATIC_IP]: "
      else
        prompt="Static IP or hostname: "
      fi
      if ! read -r -p "$prompt" input; then
        echo "Error: no input received; a static IP is required for the selfhosted provider." >&2
        exit 1
      fi
      static_ip="${input:-$RAI_STATIC_IP}"
      [ -n "$static_ip" ] && break
      echo "A static IP is required for the selfhosted provider." >&2
    done
  fi
fi

mkdir -p "$conf_dir"
{
  echo "# Generated by 'rai init'. Safe to hand-edit - see readme.md's"
  echo "# Configuration section for the full list of variables."
  echo
  echo "RAI_PROVIDER=$provider"
  if [ "$provider" = hetzner ]; then
    echo "RAI_SERVER=$server"
  else
    echo "RAI_STATIC_IP=$static_ip"
  fi
  echo
  echo '# Uncomment and edit any of these to override their defaults:'
  echo '# RAI_USER=user - SSH user'
  echo '# RAI_REMOTE_BASE=/home/$RAI_USER/workspaces - workspace root on VM'
  echo '# RAI_VOLUME=/dev/sdb - volume to mount the workspaces to and from, useful if they should be encrypted'
  echo '# RAI_MOSH_PORT= - UDP port for `rai mosh` to pin mosh-server to (default: mosh'"'"'s own 60000-61000 range)'
} > "$conf_file"

echo "Wrote $conf_file"
if [ "$provider" = hetzner ]; then
  echo "Next: make sure HCLOUD_TOKEN is set and a Hetzner server named '$server' already exists, then run 'rai start'."
else
  echo "Next: nothing to start/stop for selfhosted - 'rai ssh'/'rai push' will connect directly to $static_ip once it's reachable."
fi
