#!/bin/bash
# rai pull - Pull changes from VM back to local repo

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"

ip=$(hcloud server describe "$RAI_SERVER" -o json | jq -r '.public_net.ipv4.ip')

if [ -z "$ip" ] || [ "$ip" = "null" ]; then
  echo "Could not get VM IP. Is the server running?"
  exit 1
fi

repo_name=$(basename "$RAI_REPO_ROOT")
remote_url="ssh://$RAI_USER@$ip$RAI_REMOTE_BASE/$repo_name"

branch=$(git rev-parse --abbrev-ref HEAD)
git fetch "$remote_url" "$branch" && git merge FETCH_HEAD