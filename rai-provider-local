# rai-provider-local - Static/local-machine provider for rai-* scripts.
# Sourced (not executed) by each rai-* script, after rai-config, based on
# RAI_PROVIDER. Points at an already-running machine (e.g. your own physical
# box) via a fixed address instead of a cloud API - useful when there's no
# hypervisor integration to power it on/off, so it's always assumed to be on.
#
# Configure the address via RAI_STATIC_IP (an IP or hostname), in
# ~/.rai/config or <repo-root>/.rai/config.

provider_ip() {
  if [ -z "$RAI_STATIC_IP" ]; then
    echo "RAI_STATIC_IP is not set (required for RAI_PROVIDER=local)." >&2
    return 1
  fi
  echo "$RAI_STATIC_IP"
}

provider_status() {
  echo "running"
}

provider_start() {
  echo "RAI_PROVIDER=local: nothing to start, machine is assumed to be always on."
}

provider_stop() {
  echo "RAI_PROVIDER=local: nothing to stop, machine is assumed to be always on."
}
