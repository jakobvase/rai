#!/bin/bash
# rai code - Open VS Code connected to the VM at the current repo

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"

ip=$(hcloud server describe "$RAI_SERVER" -o json | jq -r '.public_net.ipv4.ip')
repo_name=$(basename "$RAI_REPO_ROOT")

code --remote ssh-remote+"$RAI_USER@$ip" "$RAI_REMOTE_BASE/$repo_name"