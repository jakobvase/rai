#!/bin/bash
# rai unlock - Unlock the encrypted workspace volume
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/rai-config"
source "$SCRIPT_DIR/rai-provider-$RAI_PROVIDER"
source "$SCRIPT_DIR/rai-common"

ip=$(require_ip) || exit 1

ssh -t "$RAI_USER@$ip" "
  if mountpoint -q '$RAI_REMOTE_BASE'; then
    echo 'Already unlocked and mounted.'
    exit 0
  fi
  if [ ! -e /dev/mapper/data ]; then
    sudo cryptsetup luksOpen '$RAI_VOLUME' data || exit 1
  fi
  sudo mount /dev/mapper/data '$RAI_REMOTE_BASE'
"
